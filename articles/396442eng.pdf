<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 9.1-c003 79.9690a87, 2025/03/06-19:12:03        ">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:Iptc4xmpCore="http://iptc.org/std/Iptc4xmpCore/1.0/xmlns/"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/"
    xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/"
   Iptc4xmpCore:Location="Amares"
   dc:format="image/jpeg"
   photoshop:City="Tana River"
   photoshop:Country="Kenya"
   xmpRights:Marked="True">
   <Iptc4xmpCore:CreatorContactInfo
    Iptc4xmpCore:CiAdrCity="Nairobi"
    Iptc4xmpCore:CiAdrCtry="Kenya"/>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>WHO/Billy Miaron</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">On 16th February 2023, a pupil receives her Oral Cholera Vaccine at Amares Primary School, Tana River, Kenya. At Amares primary school, there was resistance by the children to accept the OCV, but after the team, led by Ibrahim Gedi, talked to the parents and community elders and informed them of the benefits of the OCV, as a result of the community engagement talk, the whole community accepted taking the vaccine including the children in schools.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">WHO/Billy Miaron</rdf:li>
    </rdf:Alt>
   </dc:rights>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>

endstream
